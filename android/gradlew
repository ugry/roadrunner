#!/bin/sh
# Gradle wrapper stub - downloads gradle if needed
GRADLE_VERSION="8.10.2"
GRADLE_ZIP="gradle-${GRADLE_VERSION}-bin.zip"
GRADLE_DIR="$HOME/.gradle/wrapper/dists/${GRADLE_ZIP}"

if [ ! -d "$GRADLE_DIR/gradle-${GRADLE_VERSION}" ]; then
    mkdir -p "$GRADLE_DIR"
    echo "Downloading Gradle ${GRADLE_VERSION}..."
    curl -sL "https://services.gradle.org/distributions/${GRADLE_ZIP}" -o "/tmp/${GRADLE_ZIP}"
    unzip -qo "/tmp/${GRADLE_ZIP}" -d "$GRADLE_DIR"
    rm "/tmp/${GRADLE_ZIP}"
fi

exec "$GRADLE_DIR/gradle-${GRADLE_VERSION}/bin/gradle" "$@"
