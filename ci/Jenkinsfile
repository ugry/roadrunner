// Insucar CI: build+push the API image with Kaniko (in-cluster, no Docker daemon),
// then trigger the Spinnaker gated deploy pipeline via its webhook.
pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command: ["sleep"]
      args: ["9999999"]
      resources:
        requests: { cpu: "250m", memory: "512Mi" }
    - name: tools
      image: curlimages/curl:8.10.1
      command: ["sleep"]
      args: ["9999999"]
'''
    }
  }

  environment {
    ECR   = "326804802908.dkr.ecr.eu-west-1.amazonaws.com/insucar-api"
    TAG   = "${env.BUILD_NUMBER}"
    SPINNAKER_WEBHOOK = "http://afac25beae62d4f0cab340b254e5e6f2-1288246793.eu-west-1.elb.amazonaws.com/webhooks/webhook/insucar-ci"
  }

  options { disableConcurrentBuilds() }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build & push (Kaniko -> ECR)') {
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="$(pwd)/prototype/backend" \
              --dockerfile="$(pwd)/prototype/backend/Dockerfile" \
              --destination="$ECR:$TAG" \
              --destination="$ECR:latest" \
              --cache=true
          '''
        }
      }
    }

    stage('Trigger Spinnaker deploy') {
      steps {
        container('tools') {
          sh '''
            curl -sS -X POST "$SPINNAKER_WEBHOOK" \
              -H "Content-Type: application/json" \
              -d "{\\"parameters\\":{\\"imageTag\\":\\"$TAG\\"}}"
            echo "triggered Spinnaker (imageTag=$TAG)"
          '''
        }
      }
    }
  }

  post {
    success { echo "CI OK — pushed $ECR:$TAG and triggered Spinnaker" }
    failure { echo "CI FAILED" }
  }
}
