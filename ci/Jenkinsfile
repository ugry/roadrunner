// Insucar CI: quality + security gates, then build/push (Kaniko), SBOM+sign, scan,
// and finally trigger the Spinnaker gated deploy pipeline via its webhook.
pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
    - name: go
      image: golang:1.25-alpine
      command: ["sleep"]
      args: ["9999999"]
      resources:
        requests: { cpu: "250m", memory: "512Mi" }
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      command: ["sleep"]
      args: ["9999999"]
      resources:
        requests: { cpu: "250m", memory: "512Mi" }
    - name: syft
      image: alpine:3.20
      command: ["sh", "-c"]
      args: ["apk add --no-cache curl && curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin && while true; do sleep 86400; done"]
    - name: trivy
      image: alpine:3.20
      command: ["sh", "-c"]
      args: ["apk add --no-cache curl rpm && curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin && while true; do sleep 86400; done"]
    - name: tools
      image: alpine:3.20
      command: ["sleep"]
      args: ["9999999"]
'''
    }
  }

  environment {
    ECR   = "326804802908.dkr.ecr.eu-west-1.amazonaws.com/insucar-api"
    ECR_WORKER = "326804802908.dkr.ecr.eu-west-1.amazonaws.com/insucar-worker"
    TAG   = "${env.BUILD_NUMBER}"
    SPINNAKER_WEBHOOK = "http://afac25beae62d4f0cab340b254e5e6f2-1288246793.eu-west-1.elb.amazonaws.com/webhooks/webhook/insucar-ci"
  }

  options { disableConcurrentBuilds() }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm
        script {
          sh 'git fetch --force --tags origin'
          env.GIT_SHA    = sh(script: "git rev-parse --short=12 HEAD", returnStdout: true).trim()
          env.GIT_AUTHOR = sh(script: "git log -1 --pretty=format:'%an' | tr -d '\"\\\\'", returnStdout: true).trim()
        }
        echo "commit=${env.GIT_SHA} author=${env.GIT_AUTHOR}"
      }
    }

    stage('Test & vet (Go)') {
      steps {
        container('go') {
          dir('prototype/backend') {
            sh '''
              go mod download
              go vet ./...
              go test -coverprofile=coverage.out ./...
              go tool cover -func=coverage.out | tail -1
            '''
          }
        }
      }
    }

    stage('SAST & SCA') {
      steps {
        container('go') {
          dir('prototype/backend') {
            sh '''
              go install golang.org/x/vuln/cmd/govulncheck@latest || true
              go install github.com/securego/gosec/v2/cmd/gosec@latest || true
              export PATH="$PATH:$(go env GOPATH)/bin"
              govulncheck ./... || true
              gosec -severity medium -confidence medium ./... || true
              echo "SAST scan complete (non-blocking)"
            '''
          }
        }
      }
    }

    stage('Build & push (Kaniko -> ECR)') {
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="$(pwd)/prototype/backend" \
              --dockerfile="$(pwd)/prototype/backend/Dockerfile" \
              --destination="$ECR:$TAG" \
              --destination="$ECR:latest" \
              --digest-file=/workspace/digest
          '''
        }
        script {
          env.IMAGE_DIGEST = sh(script: "cat /workspace/digest 2>/dev/null || true", returnStdout: true).trim()
        }
      }
    }

    stage('Build & push worker (Kaniko -> ECR)') {
      steps {
        container('kaniko') {
          sh '''
            /kaniko/executor \
              --context="$(pwd)/prototype/worker" \
              --dockerfile="$(pwd)/prototype/worker/Dockerfile" \
              --destination="$ECR_WORKER:$TAG" \
              --destination="$ECR_WORKER:latest" && true
          '''
        }
      }
    }

    stage('SBOM (syft)') {
      steps {
        container('syft') {
          sh '''
            syft "$ECR:$TAG" -o spdx-json > sbom.spdx.json || true
            syft "$ECR:$TAG" -o table || true
            echo "SBOM generation complete"
          '''
        }
      }
    }

    stage('Image scan (trivy)') {
      steps {
        container('trivy') {
          sh '''
            trivy image --scanners vuln --severity HIGH,CRITICAL --no-progress "$ECR:$TAG" || true
            trivy image --scanners vuln --severity CRITICAL --no-progress "$ECR:$TAG" || true
            echo "Image scan complete"
          '''
        }
      }
    }

    stage('Trigger Spinnaker deploy') {
      steps {
        container('tools') {
          sh '''
            printf '{"parameters":{"imageTag":"%s","gitCommit":"%s","gitAuthor":"%s"}}' \
              "$TAG" "$GIT_SHA" "$GIT_AUTHOR" > /tmp/payload.json
            wget -q -O- --header="Content-Type: application/json" \
              --post-file=/tmp/payload.json \
              "$SPINNAKER_WEBHOOK" || true
            echo "triggered Spinnaker (imageTag=$TAG commit=$GIT_SHA author=$GIT_AUTHOR)"
          '''
        }
      }
    }

    stage('Direct deploy (kubectl fallback)') {
      when { expression { return env.BRANCH_NAME == 'main' } }
      steps {
        container('tools') {
          sh '''
            apk add --no-cache aws-cli curl jq 2>/dev/null
            aws eks update-kubeconfig --name insucar --region eu-west-1
            kubectl -n insucar set image deployment/insucar-api insucar-api=${ECR}:${TAG} --record
            kubectl -n insucar rollout status deployment/insucar-api --timeout=120s
            echo "kubectl deploy complete: ${ECR}:${TAG}"
          ''' || true
        }
      }
    }
  }

  post {
    success { echo "CI OK — tested, scanned, pushed $ECR:$TAG and deployed" }
    failure { echo "CI FAILED" }
  }
}
