{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/roadrunner.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow",
        "webfetch": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "question": "allow"
      },
      "steps": 100
    }
  }
}
