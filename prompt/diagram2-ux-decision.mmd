%%{init: {"theme":"base","themeVariables":{"fontSize":"15px","fontFamily":"Helvetica, Arial, sans-serif"},"flowchart":{"nodeSpacing":40,"rankSpacing":55}}}%%
flowchart TB
  subgraph IN["INPUTS (from caller / IVR / systems)"]
    direction TB
    I1["ANI phone number"]:::in
    I2["Spoken intent (Lex): won't-start / accident / ill / other"]:::in
    I3["GPS location / what3words"]:::in
    I4["Safety answers: injured? fire? live traffic?"]:::in
    I5["Policy + vehicle (ANI lookup)"]:::in
  end

  START(["Inbound call (mock Amazon Connect)"]):::client
  START --> I1 & I2 & I3 & I4 & I5

  D0{"Life-safety?<br/>injury / fire / medical"}:::dec
  I4 --> D0
  D0 -->|YES Tier-0| PSAP["OUTPUT: warm-transfer 112/PSAP<br/>+ create emergency case"]:::out
  D0 -->|NO| POP["OUTPUT: screen-pop to operator<br/>customer/policy/vehicle/priority"]:::out
  I1 & I2 & I5 --> POP

  POP --> PHONEFIX{"Coordinator: phone-fix possible?"}:::dec
  PHONEFIX -->|YES| RESOLVED["OUTPUT: resolved remotely<br/>close case, no dispatch"]:::out
  PHONEFIX -->|NO| COV{"Covered by policy?"}:::dec

  COV -->|NO| PAY["OUTPUT: offer pay-per-use / excess (PCI)<br/>or decline gracefully"]:::out
  COV -->|YES| SVC{"Required service?"}:::dec
  I2 & I3 --> SVC

  SVC -->|repair on spot| M1["OUTPUT: dispatch patrol"]:::out
  SVC -->|tow| M2["OUTPUT: dispatch tow -> workshop"]:::out
  SVC -->|repatriation| M3["OUTPUT: cross-border transport"]:::out
  SVC -->|journey continuation| M4["OUTPUT: rental / taxi / train"]:::out
  SVC -->|EV / micromobility| M5["OUTPUT: EV charge / bike unit"]:::out

  M1 & M2 & M3 & M4 & M5 --> MATCH["Provider matching:<br/>nearest + availability + score"]:::proc
  MATCH --> FB{"Provider accepts?"}:::dec
  FB -->|NO| MATCH2["Fallback chain / manual click-to-dial"]:::proc --> MATCH
  FB -->|YES| DISP["OUTPUTS: mission created · live ETA/geo-track ·<br/>SMS status link + driver name/plate/photo ·<br/>audit-ledger entry"]:::out

  DROP{"Call dropped?"}:::dec
  START -. dead zone .-> DROP
  DROP -->|YES| CB["OUTPUT: outbound callback<br/>+ resume case"]:::out

  classDef client fill:#eef6ff,stroke:#2b6cb0,stroke-width:2px,color:#1a365d;
  classDef in fill:#f7fafc,stroke:#4a5568,stroke-width:1.5px,color:#2d3748;
  classDef dec fill:#fffaf0,stroke:#b7791f,stroke-width:2px,color:#5f370e;
  classDef out fill:#e6fffa,stroke:#319795,stroke-width:2px,color:#234e52;
  classDef proc fill:#faf5ff,stroke:#805ad5,stroke-width:2px,color:#44337a;
