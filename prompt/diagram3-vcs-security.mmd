%%{init: {"theme":"base","themeVariables":{"fontSize":"15px","fontFamily":"Helvetica, Arial, sans-serif"},"flowchart":{"nodeSpacing":40,"rankSpacing":55}}}%%
flowchart TB
  subgraph VCS["Version control & promotion"]
    direction TB
    GIT["Git (private repo ugry/insucar)<br/>PR + review + change ticket"]:::vcs
    CI["Jenkins CI: build+test+scan -> Kaniko -> ECR"]:::vcs
    SP["Spinnaker CD pipeline (gated)"]:::vcs
    GIT --> CI --> SP
  end

  subgraph ENV["Environments (isolation) — design: separate AWS accounts"]
    direction LR
    DEV["DEV<br/>free iteration"]:::dev
    UAT["UAT (pre-production)<br/>== prod config"]:::uat
    PROD["PRODUCTION<br/>read-only by default"]:::prod
    DEV -->|"Spinnaker: manual judgment"| UAT
    UAT -->|"manual judgment (PRODUCT OWNER)"| PROD
  end
  SP --> DEV

  subgraph IAM["Entitlements / access design (3 security-group cases)"]
    direction TB
    G1["Group: developers<br/>FULL in DEV · ZERO in UAT/PROD"]:::g
    G2["Group: uat-preprod<br/>DEV devs reach UAT: read-biased,<br/>pipeline-only deploy, no manual mutation"]:::g
    G3["Group: devops-prod<br/>READ-ONLY standing in PROD"]:::g
    G4["JIT break-glass (PROD write)<br/>emergency / release / change only"]:::jit
    PO{{"Approver = PRODUCT OWNER<br/>(distinct identity, no self-approval)"}}:::po
    LEDGER["Immutable blockchain / hash-chained ledger<br/>who · when · why · approver · expiry<br/>(mirrored to auth.log)"]:::ledger
    G3 --> G4
    G4 -->|request| PO
    PO -->|approve, time-bound STS + MFA| GRANT["Temporary PROD write<br/>auto-expires"]:::grant
    GRANT --> LEDGER
  end

  G1 -. dev-tier only .-> DEV
  G2 -. read/pipeline .-> UAT
  G3 -. read-only .-> PROD
  GRANT -. write during window .-> PROD

  subgraph SEC["Cross-cutting security"]
    direction LR
    S1["Separate accounts / IAM / KMS / secrets per tier"]:::sec
    S2["RLS multi-tenant isolation (tenant_id)"]:::sec
    S3["Rust vault: PII tokenization, mTLS-only, isolated"]:::sec
    S4["Hidden operator surface · MFA · zero-trust"]:::sec
    S5["Secrets in AWS Secrets Manager (no secrets in code)"]:::sec
  end
  PROD --- S1
  ENV --- S2

  classDef vcs fill:#edf2f7,stroke:#4a5568,stroke-width:2px,color:#2d3748;
  classDef dev fill:#e6fffa,stroke:#319795,stroke-width:2px,color:#234e52;
  classDef uat fill:#fffaf0,stroke:#b7791f,stroke-width:2px,color:#5f370e;
  classDef prod fill:#fff5f5,stroke:#c53030,stroke-width:2px,color:#742a2a;
  classDef g fill:#eef6ff,stroke:#2b6cb0,stroke-width:2px,color:#1a365d;
  classDef jit fill:#fefcbf,stroke:#d69e2e,stroke-width:2px,color:#5f370e;
  classDef po fill:#faf5ff,stroke:#805ad5,stroke-width:2px,color:#44337a;
  classDef grant fill:#f0fff4,stroke:#38a169,stroke-width:2px,color:#22543d;
  classDef ledger fill:#f7fafc,stroke:#1a202c,stroke-width:3px,color:#1a202c;
  classDef sec fill:#fff4e6,stroke:#dd6b20,stroke-width:2px,color:#7b341e;
