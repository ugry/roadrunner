{
  "name": "insucar-canary-config",
  "description": "Canary analysis config for Insucar API deployments. 5% traffic for 10 min, auto-rollback on error rate > 1% or latency p99 > 500ms.",
  "application": "insucar",
  "metric": [
    {
      "name": "error_rate",
      "query": {
        "type": "prometheus",
        "metricName": "http_requests_total",
        "labelBindings": ["status=~'5..'"],
        "serviceType": "prometheus"
      },
      "analysisConfigurations": {
        "canary": {
          "direction": "increase",
          "nanStrategy": "remove",
          "effectSize": {
            "allowedIncrease": 2.0
          }
        }
      },
      "scopeName": "default"
    },
    {
      "name": "latency_p99",
      "query": {
        "type": "prometheus",
        "metricName": "http_request_duration_seconds",
        "labelBindings": ["quantile='0.99'"],
        "serviceType": "prometheus"
      },
      "analysisConfigurations": {
        "canary": {
          "direction": "increase",
          "nanStrategy": "remove",
          "effectSize": {
            "allowedIncrease": 500
          }
        }
      },
      "scopeName": "default"
    }
  ],
  "canaryConfig": {
    "lifetimeDuration": "PT10M",
    "analysisInterval": "PT2M",
    "trafficPercentage": 5,
    "judge": "NetflixACAJudge-v1.0",
    "canaryHealthCheckHandler": {
      "minimumCanaryResultScore": 75
    },
    "canarySuccessCriteria": {
      "canaryResultScore": 75
    }
  }
}
