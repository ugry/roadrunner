{
  "application": "insucar",
  "keepWaitingPipelines": false,
  "limitConcurrent": false,
  "name": "deploy-insucar-api",
  "parameterConfig": [
    {
      "default": "latest",
      "description": "ECR image tag to deploy. Set by the Jenkins CI webhook (parameters.imageTag); falls back to 'latest' for manual runs.",
      "hasOptions": false,
      "name": "imageTag",
      "pinned": true,
      "required": false
    },
    {
      "default": "unknown",
      "description": "Git commit SHA that produced this image (traceability; set by CI).",
      "hasOptions": false,
      "name": "gitCommit",
      "required": false
    },
    {
      "default": "unknown",
      "description": "Git commit author that produced this image (traceability; set by CI).",
      "hasOptions": false,
      "name": "gitAuthor",
      "required": false
    }
  ],
  "schema": "1",
  "stages": [
    {
      "account": "insucar-eks",
      "cloudProvider": "kubernetes",
      "manifests": [
        {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "metadata": {
            "annotations": {
              "insucar.io/git-author": "${ (trigger.payload?.parameters?.gitAuthor ?: parameters.gitAuthor) ?: 'unknown' }",
              "insucar.io/git-commit": "${ (trigger.payload?.parameters?.gitCommit ?: parameters.gitCommit) ?: 'unknown' }",
              "insucar.io/image-tag": "${ (trigger.payload?.parameters?.imageTag ?: parameters.imageTag) ?: 'latest' }"
            },
            "labels": {
              "app": "insucar-api"
            },
            "name": "insucar-api",
            "namespace": "insucar-dev"
          },
          "spec": {
            "replicas": 2,
            "selector": {
              "matchLabels": {
                "app": "insucar-api"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "insucar-api"
                }
              },
              "spec": {
                "containers": [
                  {
                    "envFrom": [
                      {
                        "configMapRef": {
                          "name": "insucar-config"
                        }
                      },
                      {
                        "secretRef": {
                          "name": "insucar-app"
                        }
                      }
                    ],
                    "image": "${ '326804802908.dkr.ecr.eu-west-1.amazonaws.com/insucar-api:' + ((trigger.payload?.parameters?.imageTag ?: parameters.imageTag) ?: 'latest') }",
                    "name": "insucar-api",
                    "ports": [
                      {
                        "containerPort": 8080
                      }
                    ],
                    "readinessProbe": {
                      "httpGet": {
                        "path": "/healthz",
                        "port": 8080
                      },
                      "initialDelaySeconds": 5,
                      "periodSeconds": 5
                    },
                    "resources": {
                      "limits": {
                        "cpu": "500m",
                        "memory": "256Mi"
                      },
                      "requests": {
                        "cpu": "100m",
                        "memory": "64Mi"
                      }
                    }
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "ecr-cred"
                  }
                ],
                "serviceAccountName": "insucar-api"
              }
            }
          }
        },
        {
          "apiVersion": "v1",
          "kind": "Service",
          "metadata": {
            "name": "insucar-api",
            "namespace": "insucar-dev"
          },
          "spec": {
            "ports": [
              {
                "port": 80,
                "targetPort": 8080
              }
            ],
            "selector": {
              "app": "insucar-api"
            },
            "type": "ClusterIP"
          }
        },
        {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "metadata": {
            "labels": {
              "app": "insucar-worker"
            },
            "name": "insucar-worker",
            "namespace": "insucar-dev"
          },
          "spec": {
            "replicas": 2,
            "selector": {
              "matchLabels": {
                "app": "insucar-worker"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "insucar-worker"
                }
              },
              "spec": {
                "containers": [
                  {
                    "envFrom": [
                      {
                        "configMapRef": {
                          "name": "insucar-config"
                        }
                      },
                      {
                        "secretRef": {
                          "name": "insucar-app"
                        }
                      }
                    ],
                    "image": "${ '326804802908.dkr.ecr.eu-west-1.amazonaws.com/insucar-worker:' + ((trigger.payload?.parameters?.imageTag ?: parameters.imageTag) ?: 'latest') }",
                    "name": "insucar-worker",
                    "resources": {
                      "limits": {
                        "cpu": "250m",
                        "memory": "128Mi"
                      },
                      "requests": {
                        "cpu": "50m",
                        "memory": "32Mi"
                      }
                    }
                  }
                ],
                "imagePullSecrets": [
                  {
                    "name": "ecr-cred"
                  }
                ],
                "serviceAccountName": "insucar-api"
              }
            }
          }
        }
      ],
      "moniker": {
        "app": "insucar"
      },
      "name": "Deploy DEV",
